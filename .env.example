# Copia in .env (che NON va mai committato) e compila.

# Token da @BotFather
TELEGRAM_BOT_TOKEN=
# Chat dove arrivano i segnali (il tuo user id, un gruppo o un canale)
TELEGRAM_CHAT_ID=
# User id autorizzati a usare i comandi e i pulsanti, separati da virgola
TELEGRAM_ALLOWED_USERS=

# Solo per mode = "live". Crea una chiave API con SOLO permesso di trading
# (prelievi DISATTIVATI) e, se possibile, limitata al tuo IP.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Alcuni exchange (es. OKX) richiedono anche una passphrase
EXCHANGE_API_PASSWORD=

# Per abilitare gli ordini reali scrivi esattamente: HO_CAPITO_I_RISCHI
LIVE_TRADING_CONFIRM=
